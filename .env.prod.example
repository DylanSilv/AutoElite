# Copiar a .env.prod y completar. Nunca commitear el archivo real.
#
# Generar cada secreto por separado con:
#   openssl rand -base64 48

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=autoelite
MYSQL_USER=autoelite
MYSQL_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Dominio desde el que se sirve el panel.
CORS_ORIGINS=http://localhost
# Poner en true en cuanto haya HTTPS delante: sin eso, la cookie de sesión
# viaja en claro.
COOKIE_SECURE=false

WEB_PORT=80
LOG_LEVEL=info

# Contraseña del usuario dueño que crea el seed. En producción es obligatoria:
# sin ella el seed se niega a correr con una clave por defecto.
SEED_OWNER_EMAIL=admin@pizzeria.local
SEED_OWNER_PASSWORD=

# WhatsApp (avisos automáticos al cliente)
#
# "log" simula los envíos y los deja en la consola: alcanza para probar todo el
# flujo sin cuenta de Meta ni gastar conversaciones. Para enviar de verdad,
# poner "cloud" y completar las credenciales de WhatsApp Business Cloud API.
WHATSAPP_PROVIDER=log
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
MESSAGING_DISPATCH_INTERVAL_MS=10000
