# Copiar a .env y completar. Nunca commitear el .env real.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos
DATABASE_URL="mysql://root:root@localhost:3306/autoelite"

# Firma de tokens. En producción usar valores largos y aleatorios y distintos entre sí.
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET="cambiar-esto-por-un-secreto-largo-y-aleatorio-min-32"
JWT_REFRESH_SECRET="cambiar-esto-por-otro-secreto-largo-y-aleatorio-min-32"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Orígenes permitidos del panel web, separados por coma
CORS_ORIGINS="http://localhost:5173"

# Cookies del refresh token: en producción debe ser true (requiere HTTPS)
COOKIE_SECURE=false
