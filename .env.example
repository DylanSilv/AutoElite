# Copiar a .env y completar. Nunca commitear el .env real.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos
#
# MYSQL_PORT es el puerto por el que docker compose publica MySQL en tu máquina.
# Si ya tenés un MySQL local ocupando el 3306, cambiá los dos valores de abajo a
# 3307 (o al que prefieras) y listo: adentro del contenedor sigue en 3306.
MYSQL_PORT=3306
DATABASE_URL="mysql://root:root@localhost:3306/autoelite"

# Firma de tokens. En producción usar valores largos y aleatorios y distintos entre sí.
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET="cambiar-esto-por-un-secreto-largo-y-aleatorio-min-32"
JWT_REFRESH_SECRET="cambiar-esto-por-otro-secreto-largo-y-aleatorio-min-32"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Orígenes permitidos del panel web, separados por coma
CORS_ORIGINS="http://localhost:5173"

# Cookies del refresh token: en producción debe ser true (requiere HTTPS)
COOKIE_SECURE=false

# WhatsApp (avisos automáticos al cliente)
#
# "log" simula los envíos y los deja en la consola: alcanza para probar todo el
# flujo sin cuenta de Meta ni gastar conversaciones. Para enviar de verdad,
# poner "cloud" y completar las credenciales de WhatsApp Business Cloud API.
WHATSAPP_PROVIDER=log
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
MESSAGING_DISPATCH_INTERVAL_MS=10000

# Webhook entrante de WhatsApp
#
# WHATSAPP_VERIFY_TOKEN lo inventás vos y lo pegás igual en Meta al dar de alta
# el webhook. WHATSAPP_APP_SECRET lo da Meta y es lo que permite verificar que
# cada entrega viene de ellos: sin él, en producción la API rechaza el webhook.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# Asistente conversacional
#
# "scripted" es un asistente por reglas que no necesita credenciales ni red:
# entiende la carta, las promos, arma pedidos y pide el pago. Alcanza para
# probar y mostrar todo el flujo. Para usar un modelo de lenguaje, poner
# "anthropic" u "openai" y completar clave y modelo (ambos obligatorios).
LLM_PROVIDER=scripted
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=          # para servicios compatibles con OpenAI o modelos propios
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000
AGENT_MAX_TOOL_ROUNDS=4
